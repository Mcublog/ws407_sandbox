{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: build active target",
            "command": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            }
        },
        {
            "type": "cmake",
            "label": "CMake: clean rebuild active",
            "command": "cleanRebuild",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            }
        },
        {
            "type": "shell",
            "label": "Flash: fw",
            "command": "JLink",
            "dependsOn": "CMake: build active target",
            "args": [
                "-CommanderScript",
                "${command:cmake.launchTargetPath}.jlink"
            ],
            "group": "test"
        },
        {
            "label": "Delete: build dir",
            "type": "shell",
            "windows": {
                "command": "rm",
                "args": [
                    "build",
                    "-r",
                    "-force"
                ]
            },
            "linux": {
                "command": "rm",
                "args": [
                    "-rf",
                    "build"
                ]
            },
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}